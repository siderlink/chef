{
    "name": "chef-cozinha",
    "version": "1.0.0",
    "main": "server.js",
    "bin": "server-prod.js",
    "scripts": {
        "prestart": "node boot.js",
        "start": "node --max-old-space-size=4096 setup-quiz.js",
        "start:direct": "concurrently \"node --max-old-space-size=4096 server.js\" \"cross-env NODE_OPTIONS=--max-old-space-size=4096 vite --host\"",
        "start:watchdog": "node --max-old-space-size=4096 watchdog.js",
        "dev": "vite --host",
        "build": "vite build",
        "postbuild": "node copy-super-admin.js",
        "preview": "vite preview",
        "obfuscate": "node obfuscate.js",
        "build:hub": "powershell -ExecutionPolicy Bypass -File build-hub.ps1",
        "build:pkg": "npm run build && node sync-prod.js && node obfuscate.js && powershell -ExecutionPolicy Bypass -File build-pkg.ps1",
        "build:installer": "powershell -ExecutionPolicy Bypass -File installer\\build-installer.ps1",
        "build:sync": "powershell -ExecutionPolicy Bypass -File build-sync.ps1",
        "novo-modulo": "node scripts/create-module.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-legacy": "^8.1.0",
        "cheerio": "^1.2.0",
        "concurrently": "^10.0.3",
        "cross-env": "^10.1.0",
        "javascript-obfuscator": "^5.5.0",
        "png-to-ico": "^3.0.1",
        "terser": "^5.48.0",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "acorn": "^8.17.0",
        "bcrypt": "^6.0.0",
        "better-sqlite3": "^13.0.3",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "figlet": "^1.11.4",
        "gradient-string": "^3.0.0",
        "iconv-lite": "^0.7.3",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "nanospinner": "^1.2.2",
        "promise-polyfill": "^8.3.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "sqlite3": "^6.0.1",
        "web-push": "^3.6.7",
        "whatwg-fetch": "^3.6.20",
        "xlsx": "^0.18.5"
    },
    "pkg": {
        "assets": [
            "dist/**/*",
            "cert.pfx",
            "node_modules/sqlite3/build/**/*",
            "node_modules/bcrypt/prebuilds/**/*",
            "node_modules/socket.io-client/dist/**/*"
        ],
        "targets": [
            "node18-win-x64"
        ],
        "outputPath": "installer/output"
    }
}
